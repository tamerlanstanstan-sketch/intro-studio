rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function mailOk() { return signedIn() && request.auth.token.email_verified == true; }
    // Модератор: подтверждённая почта tamshop.ru@gmail.com
    function isMod() { return mailOk() && request.auth.token.email.lower() == 'tamshop.ru@gmail.com'; }
    function notBanned() { return !exists(/databases/$(database)/documents/banned/$(request.auth.uid)); }
    function canWrite() { return mailOk() && notBanned(); }
    function okText(t, max) { return t is string && t.size() > 0 && t.size() <= max; }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 24
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 24
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    // Синяя галочка и блокировка: пишет только модератор
    match /verified/{uid} {
      allow read: if signedIn();
      allow write: if isMod();
    }
    match /banned/{uid} {
      allow read: if signedIn();
      allow write: if isMod();
    }

    match /posts/{id} {
      allow read: if signedIn();
      allow create: if canWrite()
        && request.resource.data.keys().hasOnly(['uid', 'text', 'ts'])
        && request.resource.data.uid == request.auth.uid
        && okText(request.resource.data.text, 500)
        && request.resource.data.ts == request.time;
      allow update: if canWrite()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'edited'])
        && request.resource.data.diff(resource.data).affectedKeys().hasAll(['text', 'edited'])
        && okText(request.resource.data.text, 500)
        && request.resource.data.edited == request.time;
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isMod());
    }

    match /likes/{id} {
      allow read: if signedIn();
      allow create: if canWrite()
        && request.resource.data.keys().hasOnly(['pid', 'uid', 'ts'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.pid is string
        && id == request.resource.data.pid + '_' + request.auth.uid
        && request.resource.data.ts == request.time;
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isMod());
    }

    match /comments/{id} {
      allow read: if signedIn();
      allow create: if canWrite()
        && request.resource.data.keys().hasOnly(['pid', 'uid', 'text', 'ts'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.pid is string
        && okText(request.resource.data.text, 300)
        && request.resource.data.ts == request.time;
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isMod());
    }

    // Жалобы видит и удаляет только модератор
    match /reports/{id} {
      allow read, delete: if isMod();
      allow create: if canWrite()
        && request.resource.data.keys().hasOnly(['pid', 'postUid', 'reporter', 'reason', 'ts'])
        && request.resource.data.reporter == request.auth.uid
        && request.resource.data.pid is string
        && id == request.resource.data.pid + '_' + request.auth.uid
        && request.resource.data.reason is string && request.resource.data.reason.size() <= 40
        && request.resource.data.ts == request.time;
    }

    // Личные сообщения: читает только отправитель и получатель
    match /messages/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if canWrite()
        && request.resource.data.keys().hasOnly(['from', 'to', 'participants', 'text', 'ts'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string && request.resource.data.to != request.auth.uid
        && request.resource.data.participants == [request.resource.data.from, request.resource.data.to]
        && okText(request.resource.data.text, 500)
        && request.resource.data.ts == request.time;
      allow delete: if signedIn() && resource.data.from == request.auth.uid;
    }
  }
}
